# ========================================
# TGM-Adapter Environment Configuration
# ========================================
# IMPORTANT: Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git!

# === McTime API Configuration ===
MCTIME_API_KEY=your-api-key-here
# Optional: zeigt nur diese Firma im Dropdown an (exakter Name aus McTime)
# MCTIME_ORGANIZATION_FILTER=Infocom GmbH
APP_COMPANY_NAME=MyCompany

# === Email Configuration ===
# Choose one of: smtp, resend, webhook, simulate
#
# WICHTIG für Railway:
#   - GMX/WEB.DE/Outlook SMTP funktioniert auf Railway NICHT (Cloud-IPs geblockt)
#   - Empfehlung: EMAIL_METHOD=resend  (HTTP API, kein SMTP, gratis bis 3.000 Mails/Monat)
#     https://resend.com → Account erstellen → API Key holen → RESEND_API_KEY setzen
#
EMAIL_METHOD=resend

# === Developer Panel (API-Key Onboarding) ===
DEV_PANEL_PASSWORD=change-this-password

# === RESEND (empfohlen für Railway) ===
# 1. Kostenloser Account auf https://resend.com
# 2. API Key erstellen
# 3. Absender-Domain verifizieren (oder onboarding@resend.dev für Tests nutzen)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=noreply@your-domain.com

# === SMTP Configuration (Railway-friendly provider on port 587) ===
# Recommended: Brevo SMTP (works well on Railway)
# SMTP_SERVER=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-brevo-login
# SMTP_PASSWORD=your-brevo-smtp-key
# SENDER_EMAIL=noreply@your-domain.com

# Alternative: Resend SMTP
# SMTP_SERVER=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_xxx
# SENDER_EMAIL=onboarding@resend.dev

# Default template (replace with your provider values)
SMTP_SERVER=email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SENDER_EMAIL=noreply@mctime.com
USE_TLS=true



